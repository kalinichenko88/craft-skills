 export type Row = string[];
 
@@ -53,10 +53,14 @@ export function isEmpty(row: Row): boolean {
   });
 }
 
-// parseRows: the rows of a CSV text, one for each line.
+// parseRows: the rows of a CSV text, one for each line that is not empty.
 export function parseRows(text: string): Row[] {
   const rows: Row[] = [];
-  for (const line of text.split('\n')) {
+  for (const line of text.split(/\r?\n/)) {
+    if (line === '') {
+      continue;
+    }
+
     rows.push(line.split(/[,\t]/).map(unquote));
   }
 
