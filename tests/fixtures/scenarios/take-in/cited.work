+++ b/src/parser/read.test.ts
@@ -0,0 +1,20 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+
+import { parseRows } from './read.ts';
+
+test('parseRows gives no row for the line break at the end of the text', () => {
+  assert.deepEqual(parseRows('a,b\n'), [['a', 'b']]);
+});
+
+test('parseRows gives no row for an empty line between two rows', () => {
+  assert.deepEqual(parseRows('a\n\nb'), [['a'], ['b']]);
+});
+
+test('parseRows gives a row for a line that holds only a space', () => {
+  assert.deepEqual(parseRows('a\n \nb'), [['a'], [' '], ['b']]);
+});
+
+test('parseRows gives no row for an empty line in a text with CRLF line breaks', () => {
+  assert.deepEqual(parseRows('a,b\r\n\r\nc,d\r\n'), [['a', 'b'], ['c', 'd']]);
+});
