diff --git a/test/parser.test.ts b/test/parser.test.ts
new file mode 100644
index 0000000..3f4eb36
--- /dev/null
+++ b/test/parser.test.ts
@@ -0,0 +1,39 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+
+import { importTable } from '../src/import-table.ts';
+import { parseRows } from '../src/parser/read.ts';
+import { splitLine } from '../src/parser/split.ts';
+
+test('parseRows gives no row for an empty line', () => {
+  assert.deepEqual(parseRows('a,b\n\nc,d'), [
+    ['a', 'b'],
+    ['c', 'd'],
+  ]);
+});
+
+test('parseRows gives no last row for a text that ends with a line break', () => {
+  assert.deepEqual(parseRows('a,b\nc,d\n'), [
+    ['a', 'b'],
+    ['c', 'd'],
+  ]);
+});
+
+test('parseRows keeps the last field of a line that ends with a comma', () => {
+  assert.deepEqual(parseRows('a,b,'), [['a', 'b', '']]);
+});
+
+test('importTable gives no row for an empty line', () => {
+  assert.deepEqual(importTable('a,b\n\nc,d\n'), [
+    ['a', 'b'],
+    ['c', 'd'],
+  ]);
+});
+
+test('splitLine keeps the last field of a line that ends with a comma', () => {
+  assert.deepEqual(splitLine('a,b,'), ['a', 'b', '']);
+});
+
+test('importTable keeps the last field of a line that ends with a comma', () => {
+  assert.deepEqual(importTable('a,b,'), [['a', 'b', '']]);
+});
